// ─── Documents ───────────────────────────────────────────────────────────
enum DocumentType {
  invoice
  proforma
  quote
  credit_note
  debit_note
}

enum DocumentStatus {
  draft
  issued
  sent
  partially_paid
  paid
  overdue
  cancelled
}

model Document {
  id                 String         @id @default(cuid())
  companyId          String
  type               DocumentType
  number             String
  clientId           String?
  issueDate          DateTime
  taxEventDate       DateTime?
  dueDate            DateTime?
  currency           String         @default("EUR")
  language           String         @default("bg")
  template           String         @default("classic")
  paymentMethod      String         @default("bank_transfer")
  paidAmount         Float          @default(0)
  status             DocumentStatus @default(draft)
  isRecurring        Boolean        @default(false)
  recurrenceInterval String?
  parentDocumentId   String?
  notes              String?        @db.Text
  internalComment    String?        @db.Text
  // ДДС освобождаване (за конкретната фактура)
  vatExempt          Boolean        @default(false)
  vatExemptReason    String?        // код/текст на основанието
  clientIsIndividual Boolean        @default(false) // получателят е физическо лице (без ЕИК/ДДС)
  // Логистика: ако фактурата е издадена от получена BG→MK доставка, пази relation към
  // изходния ExportDocumentSet (§18/§41). Additive/nullable — стандартните фактури са с
  // null. Статусът „Фактурирана" на доставката се извежда от СЪЩЕСТВУВАНЕТО на активен
  // (не изтрит) Document с този sourceExportSetId.
  sourceExportSetId  String?
  // External client sharing (email + accept/reject portal)
  clientEmail        String?
  publicToken        String?        @unique
  clientDecision     String?        // accepted | rejected
  clientDecisionAt   DateTime?
  sentToClientAt     DateTime?
  // Inter-company sharing — ако получателят е регистрирана фирма в платформата
  recipientCompanyId String?
  // Soft delete (Кошче). deletedAt != null → документът е в Кошчето.
  // Записът остава физически (номерът не се освобождава); възстановяване връща
  // документа непроменен. Окончателното изтриване премахва записа.
  deletedAt          DateTime?
  deletedById        String?
  deleteReason       String?
  createdAt          DateTime       @default(now())

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client         Client?        @relation(fields: [clientId], references: [id])
  parentDocument Document?      @relation("DocumentChain", fields: [parentDocumentId], references: [id])
  childDocuments Document[]     @relation("DocumentChain")
  sourceExportSet ExportDocumentSet? @relation("ExportSetInvoices", fields: [sourceExportSetId], references: [id], onDelete: SetNull)
  lines          DocumentLine[]
  attachments    DocumentAttachment[]
  events         DocumentEvent[]
  assetLinks     AssetDocument[]      @relation("AssetDocLink")
  mkInvoice      MkInvoice?           // легаси operational wrapper (1:1), ако е свързан

  @@index([recipientCompanyId])
  @@index([companyId, deletedAt])
  @@index([sourceExportSetId])
}

// ─── Document Tracking ───────────────────────────────────────────────────
// Времева линия на събитията по изпратен документ (жизнен цикъл):
// изпратен → SMTP приет → доставен → имейлът отворен → прегледан онлайн →
// PDF свален → отпечатан → платен; както и bounce/грешка/напомняне.
// GDPR: пазим само хеширан IP и груб (браузър/ОС) User-Agent, без излишни данни.
model DocumentEvent {
  id         String   @id @default(cuid())
  documentId String
  companyId  String
  type       String   // sent | smtp_accepted | delivered | email_opened | viewed | downloaded | printed | link_visited | paid | overdue | bounced | failed | invalid_email | reminder_sent
  at         DateTime @default(now())
  channel    String?  // email | portal | system
  recipient  String?  // маскиран имейл (напр. j***@doe.com)
  meta       Json?
  ipHash     String?  // GDPR: хеширан IP, не суров
  device     String?  // груб UA: „Chrome · Windows"
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, at])
  @@index([companyId, type])
}

// Прикачени PDF документи към фактура/документ (протоколи, приложения и др.).
// Съхранение като base64 data URL (както ClientFile/EmployeeFile/ArchiveFile).
model DocumentAttachment {
  id               String   @id @default(cuid())
  documentId       String
  filename         String   // почистено име за показване/сваляне
  originalFilename String
  mimeType         String
  size             Int
  pages            Int?     // брой страници на PDF-а (ако е засечен)
  dataUrl          String   @db.Text
  uploadedById     String?
  createdAt        DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// In-app нотификации (вкл. получени документи между фирми)
model Notification {
  id        String   @id @default(cuid())
  companyId String
  type      String   // incoming_document | system | info
  // i18n: съхраняваме преводен ключ + payload, а не финален текст.
  // title/body остават като fallback за легаси записи и краен резерв.
  titleKey  String?
  bodyKey   String?
  data      Json?
  title     String?
  body      String?  @db.Text
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([companyId, read])
}

model DocumentLine {
  id               String  @id @default(cuid())
  documentId       String
  description      String
  quantity         Float
  unitPrice        Float
  vatRate          Float   @default(20)
  lineTotal        Float
  nomenclatureCode String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// ─── Expenses ────────────────────────────────────────────────────────────
model ExpenseCategory {
  id        String  @id @default(cuid())
  companyId String?
  name      String
  isCustom  Boolean @default(false)

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses Expense[]
}

enum ExpenseSource {
  manual
  incoming_invoice
}

model Expense {
  id            String        @id @default(cuid())
  companyId     String
  categoryId    String
  supplierId    String?
  projectId     String?       // разход по проект (additive, nullable)
  description   String
  invoiceNumber String?
  amount        Float
  vatAmount     Float         @default(0)
  date          DateTime
  source        ExpenseSource @default(manual)
  attachmentUrl String?
  isRecurring   Boolean       @default(false) // повтарящ се месечен разход (наем, заплати…)
  createdAt     DateTime      @default(now())

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  supplier Supplier?       @relation(fields: [supplierId], references: [id])
  project  Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

// ─── Contracts ───────────────────────────────────────────────────────────
enum ContractCounterpartyType {
  client
  supplier
}

enum ContractStatus {
  active
  expired
  cancelled
}

model Contract {
  id               String                   @id @default(cuid())
  companyId        String
  title            String
  counterpartyType ContractCounterpartyType
  clientId         String?
  supplierId       String?
  startDate        DateTime
  endDate          DateTime?
  autoRenew        Boolean                  @default(false)
  status           ContractStatus           @default(active)
  value            Float?
  notes            String?                  @db.Text
  attachmentUrl    String?                  @db.Text

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client   Client?   @relation(fields: [clientId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
}

// ─── Projects ────────────────────────────────────────────────────────────
enum ProjectStatus {
  active
  completed
  on_hold
  cancelled
}

enum ProjectEntryType {
  revenue
  expense
}

model Project {
  id                String        @id @default(cuid())
  companyId         String
  name              String
  description       String?       @db.Text
  clientId          String?
  responsibleUserId String?
  budget            Float?
  plannedBudget     Float?
  actualSpent       Float         @default(0)
  status            ProjectStatus @default(active)
  deadline          DateTime?
  progressPercent   Int           @default(0)
  parentProjectId   String?
  createdAt         DateTime      @default(now())

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client?        @relation(fields: [clientId], references: [id])
  entries ProjectEntry[]
  files   ProjectFile[]
  notes   ProjectNote[]
  expenses Expense[]
  parentProject Project?  @relation("ProjectTree", fields: [parentProjectId], references: [id])
  subProjects   Project[] @relation("ProjectTree")

  @@index([parentProjectId])
}

model ProjectNote {
  id        String   @id @default(cuid())
  projectId String
  note      String   @db.Text
  author    String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectEntry {
  id          String           @id @default(cuid())
  projectId   String
  refType     String           @default("manual")
  refId       String?
  description String?
  amount      Float
  type        ProjectEntryType
  date        DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectFile {
  id        String  @id @default(cuid())
  projectId String
  fileUrl   String
  name      String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── Assets ──────────────────────────────────────────────────────────────
model Asset {
  id                 String    @id @default(cuid())
  companyId          String
  name               String
  category           String
  acquiredDate       DateTime
  value              Float
  annualDepreciation Float     @default(0)
  bookValue          Float
  warrantyUntil      DateTime?
  insuranceUntil     DateTime?
  status             String    @default("in_use") // in_use | maintenance | sold | scrapped | written_off
  notes              String?   @db.Text

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceLogs AssetServiceLog[]
  documents   AssetDocument[]
}

model AssetServiceLog {
  id          String   @id @default(cuid())
  assetId     String
  date        DateTime
  description String

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

// Прикачени документи към актив (по желание). Съхранението следва общия механизъм
// (base64 dataUrl в БД) ИЛИ връзка към вече съществуващ Document (без дублиране).
// Всички полета извън assetId са nullable → съществуващите активи остават непроменени.
model AssetDocument {
  id               String    @id @default(cuid())
  assetId          String
  docType          String? // invoice|receipt|warranty|insurance|contract|handover|certificate|service|technical|photo|other
  // Съхранение: собствен файл ...
  filename         String?
  originalFilename String?
  mimeType         String?
  size             Int?
  dataUrl          String?   @db.Text
  // ... ИЛИ връзка към съществуващ документ (избягва дублиране на storage)
  linkedDocumentId String?
  // Незадължителни метаданни
  name             String?
  description      String?   @db.Text
  docDate          DateTime?
  number           String?
  issuer           String?
  validFrom        DateTime?
  validTo          DateTime?
  note             String?   @db.Text
  // Тип-специфични данни (гаранция/застраховка/фактура/касова бележка) — разширяемо
  data             Json?
  // Напомняне преди изтичане (дни). null = без напомняне.
  reminderDays     Int?
  reminderSentAt   DateTime?
  // Одит
  uploadedById     String?
  updatedById      String?
  deletedAt        DateTime? // soft delete (Кошче)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  linkedDocument Document? @relation("AssetDocLink", fields: [linkedDocumentId], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([validTo])
}

// ─── Handover Protocols ──────────────────────────────────────────────────
model HandoverProtocol {
  id             String   @id @default(cuid())
  companyId      String
  number         String
  // Тип протокол: "handover" (приемо-предавателен) | "ddd" (ДДД обработка)
  kind           String   @default("handover")
  counterpartyId String?
  // Свободни данни на приемащата страна
  counterpartyName    String?
  counterpartyEik     String?
  counterpartyAddress String?
  counterpartyMol     String?
  place          String?
  handedBy       String?
  receivedBy     String?
  items          String?  @db.Text
  // Приемо-предавателен: дейност + период (по образец)
  activity       String?  @db.Text
  period         String?
  // ДДД и допълнителни структурирани полета по образец
  data           Json?
  date           DateTime
  description    String?  @db.Text
  createdAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ─── Посещения на сайта (за статистика в админ панела) ───────────────────
model SiteVisit {
  id        String   @id @default(cuid())
  visitorId String
  path      String
  area      String   @default("public") // public | app
  userId    String?
  companyId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
}

// Модул „Бизнес документи" — генерирани от шаблони документи (DMS)
model BusinessDocument {
  id              String   @id @default(cuid())
  companyId       String
  templateId      String
  templateVersion Int      @default(1)
  category        String
  title           String
  contentHtml     String   @db.Text
  status          String   @default("draft") // draft | final | archived
  favorite        Boolean  @default(false)
  pinned          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, updatedAt])
}

model ArchiveFile {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  category   String?
  mimeType   String
  size       Int
  dataUrl    String   @db.Text
  uploadedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ─── Каса (cash registers) ───────────────────────────────────────────────
// Дневник на плащанията — единен регистър на получените и извършените плащания.
// Надгражда финансовата част, без да променя фактурите/касата/разходите (тези
// потоци остават непроменени; тук се води отделен, филтруем ledger). Връзките
// към клиент/доставчик/документ се пазят като id + snapshot на името/номера, за
// да не се въвеждат back-relations в съществуващите модели.
model Payment {
  id             String   @id @default(cuid())
  companyId      String
  direction      String   // in = получено · out = извършено
  status         String   @default("completed") // completed | pending
  amount         Float
  currency       String   @default("EUR")
  date           DateTime
  dueDate        DateTime?
  method         String   @default("bank_transfer") // PAYMENT_METHODS id
  reason         String?   // основание
  clientId       String?
  supplierId     String?
  counterpartyName String? // snapshot (клиент или доставчик)
  documentId     String?   // фактура/разход/друг документ
  documentRef    String?   // номер (snapshot)
  cashRegisterId String?
  bankAccount    String?   // IBAN / сметка (свободен текст)
  note           String?   @db.Text
  createdById    String?
  createdAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
  @@index([companyId, direction, status])
}

model CashRegister {
  id        String   @id @default(cuid())
  companyId String
  name      String
  currency  String   @default("EUR")
  balance   Float    @default(0)
  createdAt DateTime @default(now())

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries CashEntry[]
}

enum CashEntryType {
  in
  out
  adjust
}

model CashEntry {
  id         String        @id @default(cuid())
  registerId String
  type       CashEntryType
  amount     Float
  note       String?
  date       DateTime      @default(now())
  createdAt  DateTime      @default(now())

  register CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
}

// ─── Банкови извлечения ──────────────────────────────────────────────────
model BankStatement {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  fileUrl    String   @db.Text // data URL (PDF/Excel/CSV)
  fileType   String   // pdf | excel | csv
  periodFrom DateTime?
  periodTo   DateTime?
  note       String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ─── Subscriptions / Billing ─────────────────────────────────────────────
enum SubscriptionPlan {
  free
  start
  business
  pro
}

enum SubscriptionStatus {
  active
  cancelled
  past_due
  trialing
}

model Subscription {
  id                   String             @id @default(cuid())
  companyId            String             @unique
  plan                 SubscriptionPlan   @default(free)
  status               SubscriptionStatus @default(active)
  // Ръчно потвърждение от Супер Админ за реално получено плащане.
  // Само „received" се отчита като продаден абонамент в статистиките (MRR/ARR).
  paymentStatus        PaymentStatus      @default(pending)
  // Начин на таксуване (billing), НЕЗАВИСИМ от функционалния план и paymentStatus:
  //   "standard"   — нормална логика (платен/безплатен според плана и плащането)
  //   "cdt_client" — клиент на „Криейтив Диджитъл Тауър" ЕООД: пълен план без
  //                  такса; НЕ влиза в MRR/ARR/приходи/комисионни/чакащи плащания
  //   "internal"   — вътрешна фирма (също изключена от приходите)
  billingMode          String             @default("standard")
  cdtActivatedAt       DateTime?          // кога е активиран CDT достъпът
  cdtActivatedById     String?            // кой Супер Админ го е активирал
  cdtEndsAt            DateTime?          // опционална крайна дата (null = безсрочен)
  cdtNote              String?            @db.Text // административна бележка
  stripeSubscriptionId String?
  stripeCustomerId     String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialUsed            Boolean            @default(false)
  // Гъвкава отстъпка върху абонамента (0–100 %), независима от плана/billing.
  // Източникът се пази в discountReason (напр. multi_company_additional, promo_*,
  // individual_*), за да могат в бъдеще да се добавят кампании/индивидуални отстъпки
  // без промяна на архитектурата. null = без отстъпка.
  discountPercent      Int?
  discountReason       String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  received      // Получено плащане
  pending       // Изчаква се плащане
  not_received  // Не е получено плащане
}

model UsageCounter {
  companyId            String
  yearMonth            String
  documentsIssuedCount Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, yearMonth])
}

// ─── Analytics ───────────────────────────────────────────────────────────
model FinancialGoal {
  id            String @id @default(cuid())
  companyId     String
  year          Int
  targetRevenue Float

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year])
}

model FinancialHistory {
  id            String @id @default(cuid())
  companyId     String
  year          Int
  revenue       Float
  expenses      Float?
  profit        Float?
  employeeCount Int?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year])
}

// ─────────────────────────────────────────────────────────────
// Email automation: log, blacklist, password reset, trainings
// ─────────────────────────────────────────────────────────────

model EmailLog {
  id          String    @id @default(cuid())
  companyId   String?   // null = platform/admin email
  toEmail     String
  toName      String?
  category    String    @default("system") // account | subscription | document | reminder | admin | system
  type        String    // machine key, e.g. "welcome", "password_reset"
  subject     String
  status      String    @default("queued") // queued | sent | failed | skipped
  error       String?   @db.Text
  attempts    Int       @default(0)
  nextRetryAt DateTime?
  opensCount  Int       @default(0)
  openedAt    DateTime?
  clicksCount Int       @default(0)
  clickedAt   DateTime?
  bounced     Boolean   @default(false)
  scheduledFor DateTime?
  // Свързан документ + метаданни за прикачените файлове (име/размер), без secret URL.
  documentId  String?
  attachmentsMeta Json?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  @@index([companyId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([documentId])
}

model EmailBlacklist {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  bounces   Int      @default(0)
  unsubscribed Boolean @default(false)
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TrainingVideo {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  category    String?
  videoUrl    String?
  thumbnail   String?  @db.Text
  duration    String?
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([category])
}

// ─────────────────────────────────────────────────────────────
// Блог (SEO) — публични статии, управлявани от Супер Админ
// ─────────────────────────────────────────────────────────────
model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String?   @db.Text
  content         String    @db.Text          // HTML съдържание (снимки/видеа/линкове)
  coverImage      String?   @db.Text          // URL или base64 data URL
  author          String    @default("Екипът на Creative Digital Accounting")
  category        String?
  tags            String?                       // CSV
  // SEO
  metaTitle       String?
  metaDescription String?   @db.Text
  keywords        String?   @db.Text
  published       Boolean   @default(false)  // = (status == "published"), за съвместимост
  status          String    @default("draft") // draft | published | hidden
  publishedAt     DateTime?
  views           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

// ─────────────────────────────────────────────────────────────
// Project Management — задачи по фирми (табла), вкл. ежемесечни
// ─────────────────────────────────────────────────────────────
model ProjectBoard {
  id             String   @id @default(cuid())
  companyId      String
  clientId       String?  // по избор — свързан клиент от CRM
  name           String   // име на фирмата/колоната
  importantNotes String?  @db.Text // важни изисквания за фирмата
  links          String?  @db.Text // JSON: { site, facebook, instagram, linkedin, google, tiktok, viber, youtube, other }
  color          String?  // акцентен цвят на колоната
  order          Int      @default(0)
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks   ProjectTask[]

  @@index([companyId])
}

model ProjectTask {
  id         String   @id @default(cuid())
  companyId  String
  boardId    String
  title      String
  description String?  @db.Text // описание на задачата
  notes      String?  @db.Text // бележки
  priority   String   @default("normal") // low | normal | high | urgent
  status     String   @default("pending") // pending | assigned | in_progress | review | returned | done
  progress   Int      @default(0) // 0-100
  assigneeId String?  // userId на изпълнителя (CompanyUser)
  assigneeName String? // ръчно въведено име на изпълнител (когато не е служител)
  dueDate    DateTime?
  links      String?  @db.Text // JSON: [{ label, url }]
  monthly    Boolean  @default(false) // ежемесечна (повтаряема) задача
  period     String?  // за ежемесечни: "YYYY-MM" — за кой месец се отнася
  archived   Boolean  @default(false) // приключените се архивират автоматично
  archivedAt DateTime? // кога е архивирана (за справки по месеци/години)
  order      Int      @default(0)
  createdById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  board   ProjectBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([companyId, boardId])
  @@index([boardId, monthly])
  @@index([boardId, archived])
}

// ═══════════════════════════════════════════════════════════════════════════
// МОДУЛ „МОДНО ПРОИЗВОДСТВО" (Fashion Production) — Phase 1: настройки на модула.
// Активирането е database-driven през CompanyModuleAccess (moduleKey =
// "fashion_production"). Всички данни са изолирани по companyId, аналогично на
// логистичния модул. Следващите фази добавят материали/ledger/стилове/BOM/… .
// ═══════════════════════════════════════════════════════════════════════════
model FashionSettings {
  id        String @id @default(cuid())
  companyId String @unique

  // General
  defaultCurrency  String @default("EUR")
  laborHourlyRate  Float  @default(0) // €/час за Direct Labor
  costingMethod    String @default("weighted_average") // weighted_average (v1)
  overheadMethod   String @default("per_unit")         // per_unit | percent_labor
  overheadValue    Float  @default(0)                  // сума/бр. или % върху labor

  // Inventory
  allowNegativeStock Boolean @default(false) // по подразбиране не се допуска

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ─── Fashion Production · Phase 2: материали, категории, доставки, ledger ─────

// Категории материали (редактируеми per company). Seed-ват се defaults при първа употреба.
model FashionMaterialCategory {
  id        String  @id @default(cuid())
  companyId String
  name      String
  code      String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  materials FashionMaterial[]

  @@unique([companyId, name])
  @@index([companyId, active])
}

// Универсален материал (плат/конец/аксесоар/…) — общ модел с категории и специализирани
// nullable полета за плат/конец. Наличността НЕ се редактира директно — само през ledger.
model FashionMaterial {
  id          String  @id @default(cuid())
  companyId   String
  categoryId  String?
  name        String
  sku         String?
  supplierId  String?
  brand       String?
  description String? @db.Text
  colorName   String?
  colorCode   String?
  unit        String  @default("m") // m | pcs | g | kg | roll | spool | …
  quantity    Float   @default(0)   // текуща наличност (управлява се от ledger)
  minQuantity Float?                // минимална наличност (алармa)
  avgCost     Float   @default(0)   // среднопретеглена покупна цена
  currency    String  @default("EUR")
  lastDeliveryAt DateTime?
  active      Boolean @default(true)
  photoUrl    String? @db.Text      // мостра/снимка (dataUrl)
  note        String? @db.Text

  // Плат
  composition      String?
  widthCm          Float?
  weightGsm        Float?
  elasticityPct    Float?
  elasticityDir    String?
  // Конец
  threadType       String?
  threadThickness  String?
  metersPerSpool   Float?
  spoolsCount      Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category  FashionMaterialCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  movements FashionInventoryMovement[]
  deliveryLines FashionDeliveryLine[]
  bomItems      FashionBomItem[]
  cuttingBatches FashionCuttingBatch[]
  remnants       FashionRemnant[]

  @@unique([companyId, sku])
  @@index([companyId, categoryId])
  @@index([companyId, active])
}

// Доставка на материали (header). При потвърждаване увеличава наличности + преизчислява
// среднопретеглена цена + създава PURCHASE движения (транзакционно, idempotent).
model FashionMaterialDelivery {
  id             String  @id @default(cuid())
  companyId      String
  supplierId     String?
  date           DateTime @default(now())
  invoiceNumber  String?
  deliveryNumber String?
  transportCost  Float   @default(0)
  extraCosts     Float   @default(0)
  currency       String  @default("EUR")
  note           String? @db.Text
  // Прикачен документ (общ base64 механизъм)
  fileName         String?
  originalFilename String?
  mimeType         String?
  dataUrl          String? @db.Text
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   FashionDeliveryLine[]

  @@index([companyId, date])
}

// Ред от доставка. landedUnitCost = unitPrice + разпределени транспортни/доп. разходи.
model FashionDeliveryLine {
  id             String  @id @default(cuid())
  deliveryId     String
  materialId     String
  quantity       Float
  unit           String
  unitPrice      Float
  lineTotal      Float
  allocatedExtra Float   @default(0)
  landedUnitCost Float

  delivery FashionMaterialDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  material FashionMaterial         @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([deliveryId])
  @@index([materialId])
}

// Централен ledger на складовите движения. quantity винаги > 0; посоката е в direction.
// Никога не се редактира текущо число директно — всяка промяна е ново движение.
model FashionInventoryMovement {
  id         String @id @default(cuid())
  companyId  String
  materialId String
  type       String // PURCHASE | MANUAL_IN | MANUAL_OUT | CUTTING_CONSUMPTION | SAMPLE_CONSUMPTION | PRODUCTION_OUTPUT | SALE | DEFECT | SCRAP | REWORK | GIFT | MARKETING | STOCK_ADJUSTMENT | RETURN
  direction  String // in | out
  quantity   Float
  unit       String
  unitCost   Float?
  sourceType String? // FashionMaterialDelivery | FashionCuttingBatch | manual | …
  sourceId   String?
  date       DateTime @default(now())
  userId     String?
  note       String? @db.Text
  createdAt  DateTime @default(now())

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  material FashionMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([companyId, materialId, createdAt])
  @@index([companyId, type])
}

// ─── Fashion Production · Phase 3: модели (Style Master) + кройки (versioned) ─

// Модел дреха с пълно производствено досие (§5). Кодът е ръчен и уникален per company.
model FashionStyle {
  id          String  @id @default(cuid())
  companyId   String
  code        String  // напр. EX-SPO-DR-001
  name        String
  collection  String?
  category    String?
  season      String?
  year        Int?
  description String? @db.Text
  status      String  @default("idea") // виж STYLE_STATUSES
  photoUrl    String? @db.Text          // основна снимка (dataUrl)
  skuPrefix   String?                   // за SKU логиката на вариантите (EX-SD)
  serialized  Boolean @default(false) // LIMITED / сериализиран модел (§27)
  editionSize Int?                       // размер на тиража (напр. 100)
  colors      String[]                  // налични цветове
  sizes       String[]                  // налични размери
  approvedAt  DateTime?
  note        String? @db.Text
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  photos   FashionStylePhoto[]
  patterns FashionPattern[]
  bomItems FashionBomItem[]
  operations FashionOperation[]
  cuttingBatches FashionCuttingBatch[]
  productionOrders FashionProductionOrder[]
  samples FashionSample[]
  finishedGoods FashionFinishedGood[]
  serialUnits FashionSerializedUnit[]
  costing FashionStyleCosting?

  @@unique([companyId, code])
  @@index([companyId, status])
}

// Снимки на модел (продукт / върху модел / други). Много на брой.
model FashionStylePhoto {
  id        String  @id @default(cuid())
  styleId   String
  url       String  @db.Text // dataUrl
  kind      String  @default("product") // product | on_model | other
  caption   String?
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())

  style FashionStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@index([styleId])
}

// Кройка с версияция (§6). Всяка версия е нов запис — старите НЕ се презаписват.
model FashionPattern {
  id         String  @id @default(cuid())
  companyId  String
  styleId    String
  version    Int
  size       String?
  hasPaper   Boolean @default(false)
  hasDigital Boolean @default(false)
  hasMarker  Boolean @default(false) // готов план/маркер за кроене
  fileUrl    String? @db.Text        // прикачен файл (dataUrl)
  fileName   String?
  mimeType   String?
  photoUrl   String? @db.Text
  status     String  @default("draft") // draft | approved | archived
  author     String?
  note       String? @db.Text
  createdById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  style   FashionStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([styleId, version])
  @@index([companyId, styleId])
}

// ─── Fashion Production · Phase 4: BOM (рецепта) + overrides по размер/цвят ───

// Базов ред от рецептата на модел: материал + количество за 1 бройка (§7).
model FashionBomItem {
  id         String  @id @default(cuid())
  companyId  String
  styleId    String
  materialId String
  quantity   Float   // базово количество за 1 бройка
  unit       String
  note       String?
  sortOrder  Int     @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  style     FashionStyle         @relation(fields: [styleId], references: [id], onDelete: Cascade)
  material  FashionMaterial      @relation(fields: [materialId], references: [id], onDelete: Restrict)
  overrides FashionBomOverride[]

  @@index([companyId, styleId])
  @@index([materialId])
}

// Override на количеството по размер/цвят/вариант (§8). Липсва override → базовото.
model FashionBomOverride {
  id        String  @id @default(cuid())
  bomItemId String
  size      String  @default("")
  color     String  @default("")
  quantity  Float

  bomItem FashionBomItem @relation(fields: [bomItemId], references: [id], onDelete: Cascade)

  @@unique([bomItemId, size, color])
  @@index([bomItemId])
}

// ─── Fashion Production · Phase 5: технологични операции + производствено време ─

// Категории операции (§9) — редактируеми/разширяеми per company (seed defaults).
model FashionOperationCategory {
  id        String  @id @default(cuid())
  companyId String
  code      String?
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  operations FashionOperation[]

  @@unique([companyId, name])
  @@index([companyId, active])
}

// Машини (по желание) — за връзка към операция.
model FashionMachine {
  id        String  @id @default(cuid())
  companyId String
  name      String
  type      String?
  note      String?
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  operations FashionOperation[]

  @@index([companyId, active])
}

// Технологична операция за модел (§9). Подредба по seq. Времето храни себестойност/капацитет.
model FashionOperation {
  id           String  @id @default(cuid())
  companyId    String
  styleId      String
  seq          Int     @default(0)
  name         String
  description  String? @db.Text
  categoryId   String?
  machineId    String?
  machineLabel String? // свободен текст, ако няма въведени машини
  expectedMinutes Float @default(0) // стандартно време (мин.)
  workstation  String?
  instructions String? @db.Text
  photoUrl     String? @db.Text
  fileUrl      String? @db.Text
  note         String? @db.Text
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  style    FashionStyle               @relation(fields: [styleId], references: [id], onDelete: Cascade)
  category FashionOperationCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  machine  FashionMachine?            @relation(fields: [machineId], references: [id], onDelete: SetNull)

  @@index([companyId, styleId])
}

// ─── Fashion Production · Phase 6: кроене (Cutting Batch) + остатъци ──────────

// Кроене: приспада реалния разход плат от склада ТРАНЗАКЦИОННО при потвърждаване.
// Idempotent — потвърждава се веднъж (status guard), няма двойно приспадане.
model FashionCuttingBatch {
  id          String  @id @default(cuid())
  companyId   String
  code        String  // CUT-2026-000042
  seqYear     Int
  seqValue    Int
  styleId     String
  color       String?
  materialId  String  // платът, който се крои
  roll        String?
  batch       String?
  date        DateTime @default(now())
  status      String  @default("draft") // draft | confirmed | cancelled
  expectedFabric Float @default(0) // теоретичен разход (от BOM)
  actualFabric   Float @default(0) // реален разход
  waste          Float @default(0) // отпадък
  note        String? @db.Text
  createdById String?
  confirmedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  style    FashionStyle         @relation(fields: [styleId], references: [id], onDelete: Restrict)
  material FashionMaterial      @relation(fields: [materialId], references: [id], onDelete: Restrict)
  lines    FashionCuttingLine[]
  remnants FashionRemnant[]
  productionOrders FashionProductionOrder[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

// Скроени бройки по размер.
model FashionCuttingLine {
  id       String @id @default(cuid())
  batchId  String
  size     String
  quantity Int

  batch FashionCuttingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, size])
  @@index([batchId])
}

// Използваем остатък от плат (§13). Може по-късно да се ползва за мостри/детайли.
model FashionRemnant {
  id         String  @id @default(cuid())
  companyId  String
  batchId    String?
  materialId String
  colorName  String?
  widthCm    Float?
  lengthCm   Float?
  quantity   Float   @default(1) // брой парчета
  status     String  @default("available") // available | reserved | used | waste
  note       String? @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batch    FashionCuttingBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  material FashionMaterial      @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([materialId, status])
}

// ─── Fashion Production · Phase 7: производствени поръчки + workflow ──────────

// Производствена поръчка (§14). Свързва се с кроене; статусът върви по workflow
// CUT→SEWING→FINISHING→QC→READY (+ ON_HOLD/REWORK/CANCELLED). Броевете good/defective/
// repair/ready се управляват от следващите фази (QC/готова продукция).
model FashionProductionOrder {
  id             String  @id @default(cuid())
  companyId      String
  code           String  // PRD-2026-000026
  seqYear        Int
  seqValue       Int
  styleId        String
  color          String?
  cuttingBatchId String?
  productionBatch String?
  date           DateTime @default(now())
  status         String  @default("cut") // виж PRODUCTION_STATUSES
  qtyGood        Int     @default(0)
  qtyDefective   Int     @default(0)
  qtyRepair      Int     @default(0)
  qtyReady       Int     @default(0)
  qtyReceived    Int     @default(0) // прехвърлени в готова продукция
  note           String? @db.Text
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  style   FashionStyle                @relation(fields: [styleId], references: [id], onDelete: Restrict)
  batch   FashionCuttingBatch?        @relation(fields: [cuttingBatchId], references: [id], onDelete: SetNull)
  lines   FashionProductionOrderLine[]
  qcRecords FashionQcRecord[]
  defects   FashionDefect[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

// Скроени бройки по размер в поръчката.
model FashionProductionOrderLine {
  id          String @id @default(cuid())
  orderId     String
  size        String
  cutQuantity Int

  order FashionProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, size])
  @@index([orderId])
}

// ─── Fashion Production · Phase 8: контрол на качеството + дефекти + мостри ────

// Типове дефекти (§15) — редактируеми per company (seed defaults).
model FashionDefectCategory {
  id        String  @id @default(cuid())
  companyId String
  code      String?
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId, active])
}

// QC минаване: колко бройки са преминали годни. Броевете на поръчката се преизчисляват
// от източника (QC минавания + дефекти) → idempotent.
model FashionQcRecord {
  id               String  @id @default(cuid())
  companyId        String
  productionOrderId String
  goodQty          Int     @default(0)
  date             DateTime @default(now())
  note             String? @db.Text
  createdById      String?
  createdAt        DateTime @default(now())

  company Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   FashionProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([companyId, productionOrderId])
}

// Дефектна бройка + решение (disposition). „repaired" → готова; „scrap" → извън продажба.
model FashionDefect {
  id               String  @id @default(cuid())
  companyId        String
  productionOrderId String
  quantity         Int
  size             String?
  color            String?
  defectType       String  // снимка на името на категорията
  description      String? @db.Text
  photoUrl         String? @db.Text
  disposition      String  @default("repair") // виж DEFECT_DISPOSITIONS
  date             DateTime @default(now())
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   FashionProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([companyId, productionOrderId])
}

// Мостра (§16). Ползва реални материали (намалява наличността чрез SAMPLE_CONSUMPTION),
// но НЕ влиза в готовата продукция за продажба.
model FashionSample {
  id           String  @id @default(cuid())
  companyId    String
  styleId      String
  type         String  // виж SAMPLE_TYPES
  color        String?
  size         String?
  quantity     Int     @default(1)
  materialId   String? // ако е зададен материал → приспада се от склада
  materialQty  Float?
  date         DateTime @default(now())
  note         String? @db.Text
  createdById  String?
  createdAt    DateTime @default(now())

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  style    FashionStyle    @relation(fields: [styleId], references: [id], onDelete: Restrict)

  @@index([companyId, styleId])
}

// ─── Fashion Production · Phase 9: готова продукция (Finished Goods) ──────────

// Наличност на готова продукция на ниво Style + Color + Size (§17). Броевете се
// управляват през ledger движения; available е текущата наличност за продажба.
model FashionFinishedGood {
  id         String  @id @default(cuid())
  companyId  String
  styleId    String
  color      String  @default("")
  size       String  @default("")
  sku        String
  available  Int     @default(0)
  produced   Int     @default(0)
  sold       Int     @default(0)
  reserved   Int     @default(0)
  gifted     Int     @default(0)
  marketing  Int     @default(0)
  scrapped   Int     @default(0)
  returned   Int     @default(0)
  minStock   Int     @default(0) // минимална наличност (за препоръки)
  unitCost   Float   @default(0) // среднопретеглена себестойност/бр.
  retailPrice Float?             // препоръчана продажна цена (Phase 10)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company   Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  style     FashionStyle                  @relation(fields: [styleId], references: [id], onDelete: Restrict)
  movements FashionFinishedGoodMovement[]
  salesLines FashionSalesLine[]

  @@unique([companyId, styleId, color, size])
  @@index([companyId, styleId])
}

// Ledger на движенията на готовата продукция.
model FashionFinishedGoodMovement {
  id             String  @id @default(cuid())
  companyId      String
  finishedGoodId String
  type           String  // виж FG_MOVEMENT_TYPES
  direction      String  // in | out
  quantity       Int
  unitCost       Float?
  sourceType     String?
  sourceId       String?
  date           DateTime @default(now())
  userId         String?
  note           String? @db.Text
  createdAt      DateTime @default(now())

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  finishedGood FashionFinishedGood @relation(fields: [finishedGoodId], references: [id], onDelete: Cascade)

  @@index([companyId, finishedGoodId, createdAt])
}

// ─── Fashion Production · Phase 10: себестойност + цени + марж ─────────────────

// Ценова/себестойностна конфигурация на модел (по желание): препоръчана retail цена,
// реална продажна цена и търговски алокации за fully-loaded cost (§21, §22).
model FashionStyleCosting {
  id                 String  @id @default(cuid())
  companyId          String
  styleId            String  @unique
  retailPrice        Float?  // препоръчана/стандартна retail цена
  sellingPrice       Float?  // реална продажна цена
  marketingAlloc     Float   @default(0)
  paymentFees        Float   @default(0)
  fulfillment        Float   @default(0)
  returnsAllowance   Float   @default(0)
  logistics          Float   @default(0)
  otherAlloc         Float   @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  style   FashionStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─── Fashion Production · Phase 11: месечни отчети за продажби ─────────────────

// Ръчен месечен отчет за продажби (§18). При приключване (finalized) намалява готовата
// наличност, изчислява приход/COGS/печалба и се ЗАКЛЮЧВА. Отключване → връща движенията.
model FashionSalesReport {
  id            String  @id @default(cuid())
  companyId     String
  period        String  // YYYY-MM
  status        String  @default("draft") // draft | finalized
  currency      String  @default("EUR")
  revenue       Float   @default(0)
  cogs          Float   @default(0)
  grossProfit   Float   @default(0)
  units         Int     @default(0)
  note          String? @db.Text
  createdById   String?
  finalizedAt   DateTime?
  finalizedById String?
  unlockedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   FashionSalesLine[]

  @@unique([companyId, period])
  @@index([companyId, status])
}

// Ред от отчета: SKU (готова продукция) + количество/цена/отстъпка. При приключване се
// снапшотват себестойност/приход/COGS за историческа коректност.
model FashionSalesLine {
  id             String  @id @default(cuid())
  reportId       String
  finishedGoodId String
  quantity       Int
  price          Float
  discount       Float   @default(0)
  unitCostSnapshot Float @default(0)
  revenue        Float   @default(0)
  cogs           Float   @default(0)
  note           String?

  report       FashionSalesReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  finishedGood FashionFinishedGood @relation(fields: [finishedGoodId], references: [id], onDelete: Restrict)

  @@index([reportId])
}

// ─── Fashion Production · Phase 14: опционална сериализация (LIMITED) ──────────

// Индивидуален сериен номер за LIMITED модел (§27). Само моделите с serialized=true.
model FashionSerializedUnit {
  id              String  @id @default(cuid())
  companyId       String
  styleId         String
  serial          Int
  color           String?
  size            String?
  productionBatch String?
  status          String  @default("available") // виж SERIAL_STATUSES
  note            String? @db.Text
  soldAt          DateTime?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  style   FashionStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([companyId, styleId, serial])
  @@index([companyId, styleId])
}

// ─── „Заяви индивидуален безплатен модул" (feature/custom request) ────────────
// Клиент заявява индивидуален модул/функция/документ/справка/автоматизация и т.н.
// Заявяването е безплатно; одобрените разработки — без допълнително заплащане.
model FeatureRequest {
  id             String   @id @default(cuid())
  companyId      String
  userId         String?
  scope          String   @default("company") // company | firm
  type           String   // module | feature | document | report | automation | integration | improvement | other
  title          String
  description    String   @db.Text
  benefit        String?  @db.Text
  contactEmail   String
  contactPhone   String?
  status         String   @default("new")
  priority       String?
  assignedTo     String?
  dueDate        DateTime?
  rating         Int?
  planSnapshot   String?
  modulesSnapshot String? @db.Text
  locale         String   @default("bg")
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company     Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attachments FeatureRequestAttachment[]
  notes       FeatureRequestNote[]

  @@index([companyId, status])
  @@index([status, createdAt])
}

// Прикачен файл към заявка (base64 dataUrl — общият механизъм в платформата).
model FeatureRequestAttachment {
  id        String @id @default(cuid())
  requestId String
  fileName  String
  mimeType  String
  size      Int
  dataUrl   String @db.Text
  createdAt DateTime @default(now())

  request FeatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// Вътрешна бележка / комуникация по заявка (не се вижда от клиента, освен client_email).
model FeatureRequestNote {
  id        String @id @default(cuid())
  requestId String
  authorId  String?
  kind      String @default("note") // note | technical | estimate | status | client_email
  body      String @db.Text
  createdAt DateTime @default(now())

  request FeatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// ─── Логистика: транспортна конфигурация (влекач + ремарке + вид товар) ───────
// Реалната работна единица на автопарка: ЕДИН влекач (Vehicle) може да има няколко
// конфигурации (различни ремаркета / вид товар). Шофьорът НЕ се заключва към камиона
// (defaultDriver е само по подразбиране/последен) — реалният шофьор се snapshot-ва в
// Shipment. Company-scoped; dedup по normalized рег. номера (§33, §35).
model VehicleConfiguration {
  id             String  @id @default(cuid())
  companyId      String
  vehicleId      String  // влекач (truck)
  trailerReg     String? // ремарке (raw)
  trailerRegNorm String  @default("") // нормализиран ремарке — за dedup
  carrierId      String?
  defaultDriver  String? // основен/последен шофьор (не permanent lock)
  driverPhone    String?
  cargoMode      String  @default("") // bulk | bags | "" (неопределено)
  maxPayloadTons Float?  // максимален товар (t) — null, ако не е известен (§34)
  active         Boolean @default(true)
  source         String? // напр. „import:cement"
  notes          String? @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  carrier Carrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)

  @@unique([companyId, vehicleId, trailerRegNorm, cargoMode, carrierId])
  @@index([companyId, carrierId])
  @@index([companyId, cargoMode])
}
