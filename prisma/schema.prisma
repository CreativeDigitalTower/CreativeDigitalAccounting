generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth v5) ──────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash     String?
  name             String?
  image            String?
  isSuperAdmin       Boolean   @default(false)
  onboardedAt        DateTime?
  representativeRole String?
  preferredLanguage  String?   @default("bg") // език на интерфейса (bg|en|ru|ro|tr|el)
  marketingConsent   Boolean   @default(false)
  termsAcceptedAt    DateTime?
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  companyUsers CompanyUser[]
  auditLogs    AuditLog[]
  passwordResetTokens PasswordResetToken[]
}

// ─── Audit log (кой / кога / какво) ──────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  action    String   // create | update | delete | status_change | login | impersonate
  entity    String   // Document | Client | Expense | Company | ...
  entityId  String?
  summary   String?  @db.Text
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Company / Multi-tenant ──────────────────────────────────────────────
model Company {
  id              String   @id @default(cuid())
  name            String
  eik             String?  // български ЕИК/БУЛСТАТ (само за BG фирми)
  // Държава (ISO2, напр. BG/MK/RS). Определя validation логиката. null/BG = българска.
  countryCode     String?
  // Официален национален регистрационен номер за чуждестранни фирми (без BG checksum).
  registrationNumber String?
  vatNumber       String?
  vatRegistered   Boolean  @default(false)
  address         String?
  city            String?
  mol             String?
  sector          String?
  country         String?  @default("България")
  // Английски legal snapshot за експортни документи (invoice/CMR). Nullable, additive —
  // BG UI не се променя; ако липсва, се ползва fallback (превод на държава + BG стойност).
  nameEn          String?
  addressEn       String?
  cityEn          String?
  countryEn       String?
  // Business Profile & Smart Workspace
  businessSector   String?
  businessCategory String?
  companySize      String?
  dashboardLayout  String?  @db.Text
  isCustomLayout   Boolean  @default(false)
  logoUrl         String?
  brandColor      String?
  defaultCurrency String   @default("EUR")
  defaultLanguage String   @default("bg")
  invoiceTemplate String   @default("classic")
  bankIban        String?
  bankName        String?
  bankBic         String?
  phone           String?
  email           String?
  website         String?
  // Per-type number start values (next number = max(start, count)+1)
  invoiceNumberStart Int   @default(1)
  // ДДС настройки по подразбиране
  defaultVatExempt       Boolean @default(false) // по подразбиране не начислявай ДДС
  defaultVatExemptReason String?                 // основание по подразбиране (код)
  // Ставка на ДДС по подразбиране за НОВИ фактури (напр. 18 за MK фирми). Nullable/additive —
  // при null се ползва глобалният default (20). Editable във всяка фактура (не заключва).
  defaultVatRate         Float?
  // Логистика: може ли фирмата да СЪЗДАВА експортни доставки (BG продавач). За MK фирми
  // (получатели) → false. Additive, default true — не чупи съществуващите фирми.
  logisticsExportCreate  Boolean @default(true)
  // JSON map of email-automation preferences (which automated emails the company receives)
  emailPrefs      String?  @db.Text
  // JSON конфиг какви модули виждат служителите (роля employee): { projects, clients, suppliers, warehouse }
  employeeAccess  String?  @db.Text
  // Меко изтриване (архив) от Супер Админ — фирмата се скрива, но данните се пазят.
  archivedAt      DateTime?
  // Откъде е дошла регистрацията (напр. "invoice_portal" — клиент, получил фактура)
  referralSource  String?
  // Споделяне на документи към други регистрирани фирми през платформата (по подразбиране включено)
  shareDocsInternally Boolean @default(true)
  // ─── Счетоводна къща (мулти-фирмен режим за счетоводители) ───
  isAccountingFirm Boolean @default(false) // тази фирма е счетоводна къща/кантора
  firmPlan         String?                 // абонаментен тир (acc_start | acc_pro | acc_office | acc_enterprise)
  // Партньорска програма (за счетоводни къщи)
  partnerCode            String?  @unique   // уникален код за покани/реферал линк
  partnerPercentOverride Int?               // ръчна корекция на процента от Супер Админ (иначе по нива)
  commissionPaidTotal    Float    @default(0) // общо изплатена комисионна
  // ─── Клиентска фирма, управлявана от счетоводна къща ───
  managedByFirmId  String?                 // коя счетоводна къща я управлява
  clientStatus     String?                 // invited | active | inactive | paid
  invitedAt        DateTime?               // кога е поканена
  activatedAt      DateTime?               // кога е активирана (първо влизане/активност)
  createdAt       DateTime @default(now())

  auditLogs         AuditLog[]
  cashRegisters     CashRegister[]
  payments          Payment[]
  bankStatements    BankStatement[]

  companyUsers      CompanyUser[]
  clients           Client[]
  suppliers         Supplier[]
  warehouses        Warehouse[]
  stockItems        StockItem[]
  documents         Document[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  contracts         Contract[]
  projects          Project[]
  assets            Asset[]
  subscription      Subscription?
  usageCounters     UsageCounter[]
  financialGoals    FinancialGoal[]
  financialHistory  FinancialHistory[]
  handoverProtocols HandoverProtocol[]
  archiveFiles      ArchiveFile[]
  stockCategories   StockCategory[]
  recipes           Recipe[]
  productionOrders  ProductionOrder[]
  employees         Employee[]
  vehicles          Vehicle[]
  technologicalDocs TechnologicalDoc[]
  conformityDeclarations ConformityDeclaration[]
  stocktakes        Stocktake[]
  taxReminders      TaxReminder[]
  businessDocuments BusinessDocument[]
  subscriptionEvents SubscriptionEvent[]
  payrollMonths     PayrollMonth[]
  monthlyEntries    MonthlyEntry[]
  projectBoards     ProjectBoard[]
  projectTasks      ProjectTask[]

  // Самореференция: счетоводна къща ↔ управлявани клиентски фирми
  managingFirm      Company?  @relation("FirmClients", fields: [managedByFirmId], references: [id], onDelete: SetNull)
  managedClients    Company[] @relation("FirmClients")
  clientInvites     ClientInvite[]
  payoutRequests    CommissionPayout[]

  // ─── Бизнес група (свързани фирми, напр. BG ↔ MK) ───
  // Двете фирми остават отделни ЮЛ (отделна номерация, валута, клиенти). Групата
  // само позволява споделяне на определени оперативни документи в workflow-а.
  companyGroupId    String?
  companyGroup      CompanyGroup? @relation(fields: [companyGroupId], references: [id], onDelete: SetNull)
  moduleAccess      CompanyModuleAccess[]
  featureRequests   FeatureRequest[]
  numberSequences   NumberSequence[]
  logisticsProducts LogisticsProduct[]
  carriers          Carrier[]
  logisticsRoutes   LogisticsRoute[]
  logisticsSettings LogisticsSettings?
  shipments         Shipment[]
  logisticsProformas LogisticsProforma[]
  supplierInvoices  SupplierInvoice[]
  logisticsExchangeRates LogisticsExchangeRate[]
  vehicleConfigs         VehicleConfiguration[]
  bgMkInvoicesIssued   BgMkInvoice[] @relation("BgMkIssuer")
  bgMkInvoicesReceived BgMkInvoice[] @relation("BgMkRecipient")
  mkInvoices           MkInvoice[]
  exportSets           ExportDocumentSet[]
  exportAttachments    ExportAttachment[]
  fashionSettings      FashionSettings?
  fashionMaterials     FashionMaterial[]
  fashionCategories    FashionMaterialCategory[]
  fashionDeliveries    FashionMaterialDelivery[]
  fashionMovements     FashionInventoryMovement[]
  fashionStyles        FashionStyle[]
  fashionPatterns      FashionPattern[]
  fashionBomItems      FashionBomItem[]
  fashionOperations    FashionOperation[]
  fashionOpCategories  FashionOperationCategory[]
  fashionMachines      FashionMachine[]
  fashionCuttingBatches FashionCuttingBatch[]
  fashionRemnants      FashionRemnant[]
  fashionProductionOrders FashionProductionOrder[]
  fashionQcRecords     FashionQcRecord[]
  fashionDefects       FashionDefect[]
  fashionDefectCategories FashionDefectCategory[]
  fashionSamples       FashionSample[]
  fashionFinishedGoods FashionFinishedGood[]
  fashionStyleCostings FashionStyleCosting[]
  fashionSalesReports  FashionSalesReport[]
  fashionSerialUnits   FashionSerializedUnit[]
  fashionFgMovements   FashionFinishedGoodMovement[]

  // Уникалност на чуждестранна фирма по държава + рег. номер (nulls distinct →
  // съществуващите BG записи без countryCode/registrationNumber не са засегнати).
  @@unique([countryCode, registrationNumber])
  @@index([managedByFirmId])
  @@index([isAccountingFirm])
  @@index([companyGroupId])
}

// ─── Бизнес група: свързва няколко отделни фирми (напр. BG + MK) ─────────────
// Фирмите се присъединяват по-късно без нова migration (nullable Company.companyGroupId).
model CompanyGroup {
  id        String   @id @default(cuid())
  name      String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]
}

// ─── Индивидуален достъп до модул (per-company, database-driven) ─────────────
// Generic — позволява активиране на всеки модул за конкретна фирма без промяна на
// source code и без hardcode на ЕИК. Логистичният модул ползва moduleKey="logistics".
model CompanyModuleAccess {
  id        String   @id @default(cuid())
  companyId String
  moduleKey String   // напр. "logistics"
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleKey])
  @@index([moduleKey, enabled])
}

// ─── Атомарен брояч за последователна номерация (concurrency-safe) ───────────
// Използва се вътре в транзакция с атомарен increment под unique constraint →
// двама едновременни потребители НИКОГА не получават един и същ номер.
// Scope примери: "shipment", "supplier_invoice", "bg_mk_invoice", "mk_invoice".
// series/year позволяват отделни редици (напр. по година). Празен string = без.
model NumberSequence {
  id        String   @id @default(cuid())
  companyId String
  scope     String
  series    String   @default("")
  year      Int      @default(0)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, scope, series, year])
  @@index([companyId, scope])
}

// Покана към клиентска фирма от счетоводна къща
model ClientInvite {
  id         String    @id @default(cuid())
  firmId     String
  email      String
  name       String?
  token      String    @unique
  status     String    @default("invited") // invited | accepted | cancelled
  companyId  String?   // попълва се при приемане (създадената клиентска фирма)
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  firm Company @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, status])
}

// Заявка за изплащане на партньорска комисионна
model CommissionPayout {
  id          String    @id @default(cuid())
  firmId      String
  amount      Float
  status      String    @default("requested") // requested | paid | rejected
  note        String?
  requestedAt DateTime  @default(now())
  paidAt      DateTime?

  firm Company @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, status])
}

// История на абонаментите (заявки, плащания, промени на статус/план)
model SubscriptionEvent {
  id        String   @id @default(cuid())
  companyId String
  type      String   // request | payment | plan_change | status_change | trial | expiry
  plan      String?
  status    String?
  period    String?
  amount    Float?
  note      String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

enum CompanyRole {
  owner
  manager
  accountant
  sales
  warehouse
  viewer
  employee
}

model CompanyUser {
  userId    String
  companyId String
  role      CompanyRole @default(viewer)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
}

// ─── CRM ─────────────────────────────────────────────────────────────────
model Client {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  eik           String?
  vatNumber     String?
  address       String?
  city          String?
  country       String?  // за чуждестранни клиенти (напр. MK клиенти на SEM INTERNATIONAL)
  mol           String?
  contactPerson String?
  contactEmail  String?
  phone         String?
  // CRM
  status        String   @default("active") // lead | active | vip | inactive | lost
  stage         String   @default("new")    // pipeline: new | contacted | proposal | negotiation | won | lost
  dealValue     Float?
  birthday      DateTime?
  website       String?
  tags          String?  // CSV
  // От коя дата се работи с клиента + пренесен оборот със задна дата (миграция от друга система)
  clientSince   DateTime?
  openingRevenue Float?  @default(0)
  // Абонаментен договор (по избор) — очаквани месечни приходи
  monthlyRetainer Float?
  createdAt     DateTime @default(now())

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notes     ClientNote[]
  documents Document[]
  contracts Contract[]
  projects  Project[]
  contacts  ClientContact[]
  tasks     ClientTask[]
  files     ClientFile[]
  emails    ClientEmail[]
  mkInvoices MkInvoice[]
  historicalMetrics        ClientHistoricalMetric[]
  historicalProductMetrics ClientHistoricalProductMetric[]
}

// ─── Исторически данни за клиент (преди старта на платформата) ───────────────
// Раздел 42: ръчно въведени годишни стойности. Текущите/бъдещите данни се
// АГРЕГИРАТ автоматично от фактурите — тук са само историческите (миграция).
model ClientHistoricalMetric {
  id        String   @id @default(cuid())
  clientId  String
  year      Int
  revenue   Float?
  quantity  Float?
  unit      String   @default("t")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, year])
  @@index([clientId])
}

// Исторически данни по продукт за клиент (раздел 43): година → продукт → количество/оборот.
model ClientHistoricalProductMetric {
  id        String   @id @default(cuid())
  clientId  String
  year      Int
  product   String
  quantity  Float?
  revenue   Float?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, year])
}

// Структурирани имейл адреси на клиента + предпочитания за получаване.
// Client.contactEmail остава (обратна съвместимост) и се синхронизира с primary.
model ClientEmail {
  id               String   @id @default(cuid())
  clientId         String
  email            String
  contactName      String?
  type             String   @default("primary") // primary | accounting | manager | payments | invoices | other
  isPrimary        Boolean  @default(false)
  isActive         Boolean  @default(true)
  receivesInvoices Boolean  @default(true)
  receivesReminders Boolean @default(true)
  receivesOffers   Boolean  @default(true)
  receivesGeneral  Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, email])
  @@index([clientId])
}

model ClientContact {
  id        String  @id @default(cuid())
  clientId  String
  name      String
  position  String?
  phone     String?
  email     String?
  isPrimary Boolean @default(false)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientTask {
  id        String    @id @default(cuid())
  clientId  String
  title     String
  type      String?   // call | email | offer | contract | followup | meeting | other
  dueDate   DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, done])
}

model ClientFile {
  id         String   @id @default(cuid())
  clientId   String
  name       String
  mimeType   String
  size       Int
  dataUrl    String   @db.Text
  uploadedAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  note      String   @db.Text
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// ─── Suppliers ───────────────────────────────────────────────────────────
model Supplier {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  eik          String?
  vatNumber    String?
  address      String?
  city         String?
  contactPerson String?
  contactEmail String?
  phone        String?
  website      String?
  rating       Int?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockMovements    StockMovement[]
  expenses          Expense[]
  supplierDocuments SupplierDocument[]
  contracts         Contract[]
  shipments         Shipment[]
}

model SupplierDocument {
  id         String @id @default(cuid())
  supplierId String
  fileUrl    String
  type       String

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

// ─── Warehouse ───────────────────────────────────────────────────────────
model Warehouse {
  id        String @id @default(cuid())
  companyId String
  name      String

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockItems StockItem[]
}

model StockItem {
  id          String  @id @default(cuid())
  companyId   String
  warehouseId String
  categoryId  String?
  name        String
  sku         String?
  quantity    Float   @default(0)
  reservedQuantity Float @default(0) // заделено (свободно = quantity − reservedQuantity)
  minQuantity Float?
  unit        String  @default("бр")
  unitCost    Float?
  expiryDate  DateTime?  // null = безсрочно

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  category  StockCategory?  @relation(fields: [categoryId], references: [id])
  movements StockMovement[]
  batches   StockBatch[]
  reservations StockReservation[]
}

model StockCategory {
  id        String @id @default(cuid())
  companyId String
  name      String
  parentId  String?

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent  StockCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children StockCategory[] @relation("CategoryTree")
  items   StockItem[]
}

model StockBatch {
  id          String   @id @default(cuid())
  stockItemId String
  batchNumber String
  quantity    Float    @default(0)  // ОСТАВАЩО количество (намалява при FIFO изписване)
  initialQuantity Float?            // първоначално заприходено (за проследимост)
  unitCost    Float?
  // Партидни данни за проследимост и срокове на годност (additive, nullable).
  supplierId    String?
  supplierName  String?             // snapshot (без relation, за да не пипаме Supplier)
  deliveryDate  DateTime?           // дата на доставка
  expiryDate    DateTime?           // срок на годност (null = безсрочно)
  documentRef   String?             // входящ документ (фактура/приемо-предаване)
  note        String?
  createdAt   DateTime @default(now())

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([stockItemId, createdAt])
  @@index([expiryDate])
}

// Резервирано количество от артикул (напр. заделено за поръчка/производство).
// Свободното = StockItem.quantity − StockItem.reservedQuantity.
model StockReservation {
  id          String   @id @default(cuid())
  stockItemId String
  quantity    Float
  note        String?
  releasedAt  DateTime?
  createdAt   DateTime @default(now())

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([stockItemId])
}

// Рецепти за производство
// Производствена поръчка/партида — траен запис за всяко производство (надгражда
// текущия production run, без да променя ефекта му върху склада). Съхранява
// производствен номер, продукт, количество, себестойност, оператор, статус,
// изходна партида и вложените суровини (проследимост суровина → продукт).
model ProductionOrder {
  id            String   @id @default(cuid())
  companyId     String
  number        String
  recipeId      String?
  recipeName    String?
  outputItemId  String?
  outputName    String
  outputBatch   String?  // производствена партида на готовия продукт
  quantity      Float
  unit          String   @default("бр")
  materialsCost Float?   // сумарна себестойност на вложените суровини
  unitCost      Float?   // себестойност за единица готова продукция
  status        String   @default("completed") // planned | in_progress | completed | cancelled
  operatorId    String?
  operatorName  String?
  note          String?  @db.Text
  producedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  company      Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  consumptions ProductionConsumption[]

  @@index([companyId, producedAt])
}

// Вложена суровина в производствена поръчка (за проследимост и себестойност).
model ProductionConsumption {
  id          String  @id @default(cuid())
  orderId     String
  stockItemId String?
  itemName    String
  quantity    Float
  unit        String  @default("бр")
  unitCost    Float?
  batchNumber String?

  order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Recipe {
  id             String       @id @default(cuid())
  companyId      String
  name           String
  outputItemId   String?
  outputQuantity Float        @default(1)
  note           String?      @db.Text
  createdAt      DateTime     @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ingredients RecipeItem[]
}

model RecipeItem {
  id          String @id @default(cuid())
  recipeId    String
  stockItemId String
  quantity    Float

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

// Служители
model Employee {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  position       String?
  phone          String?
  email          String?
  address        String?
  salary         Float?
  hiredAt        DateTime?
  paidLeaveDays  Int      @default(20) // годишен платен отпуск (мин. по закон 20 раб. дни)
  active         Boolean  @default(true)
  notes          String?  @db.Text
  // Разширени данни
  department     String?  // отдел / звено
  contractType   String?  // permanent | fixed_term | civil
  paymentMethod  String   @default("bank") // bank | cash
  iban           String?  // банкова сметка за заплата
  bankName       String?
  userId         String?  @unique // свързан потребителски акаунт (self-service портал)
  createdAt      DateTime @default(now())

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaves  EmployeeLeave[]
  files   EmployeeFile[]
  bonuses EmployeeBonus[]
}

// Автомобил на фирмата — за пътни листове, отчети за гориво и разходни норми.
model Vehicle {
  id            String   @id @default(cuid())
  companyId     String
  registration  String   // регистрационен номер
  // Нормализиран рег. номер (главни, без интервали/тирета) — за dedup срещу
  // формат разлики. Nullable: старите записи (горивен модул) остават непроменени.
  normalizedRegistration String?
  brand         String?  // марка
  model         String?  // модел
  vin           String?  // рама (VIN)
  fuelType      String?  // бензин | дизел | газ | ел. | хибрид
  fuelNorm      Float?   // разходна норма л/100 км
  tankCapacity  Float?   // обем на резервоара (л)
  year          Int?
  odometer      Float?   // текущ пробег (км)
  notes         String?  @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logisticsProfile VehicleLogisticsProfile?
  aliases          VehicleAlias[]
  logisticsDocuments VehicleDocument[]
  shipments        Shipment[]
  configurations   VehicleConfiguration[]

  @@unique([companyId, normalizedRegistration])
  @@index([companyId])
}

// ─── Логистичен модул: master data (companion към Vehicle, без isLogistics) ──
// Специфични за логистиката данни за автомобил. Основният registration НЕ се дублира.
model VehicleLogisticsProfile {
  id            String   @id @default(cuid())
  vehicleId     String   @unique
  trailerReg    String?  // ремарке
  carrierId     String?  // превозвач
  defaultDriver String?  // шофьор по подразбиране
  ownershipType String?  // own | carrier | subcontractor | unspecified (по подразбиране неопределено)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicle Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  carrier Carrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)

  @@index([carrierId])
}

// Alias/import идентификатор на автомобил (потвърдени съкратени номера от Excel).
// vehicleId е nullable → непотвърден historical alias може да съществува и да бъде
// свързан ръчно към правилния автомобил по-късно, когато получим пълния номер.
model VehicleAlias {
  id             String  @id @default(cuid())
  companyId      String
  alias          String
  normalizedAlias String
  vehicleId      String?
  createdAt      DateTime @default(now())

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@unique([companyId, normalizedAlias])
  @@index([vehicleId])
}

// Документи към автомобил (досие): рег. документ, застраховка, тех. преглед и др.
model VehicleDocument {
  id               String    @id @default(cuid())
  vehicleId        String
  docType          String? // registration|insurance|inspection|license|permit|contract|certificate|other
  name             String?
  number           String?
  issueDate        DateTime?
  validTo          DateTime?
  filename         String?
  originalFilename String?
  mimeType         String?
  size             Int?
  dataUrl          String?   @db.Text
  notes            String?   @db.Text
  uploadedById     String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([validTo])
}

// Продуктова номенклатура за логистичния модул (цименти + Holcim material code).
model LogisticsProduct {
  id             String   @id @default(cuid())
  companyId      String
  canonicalName  String
  normalizedName String   // за dedup/съпоставяне
  materialCode   String?  // Holcim material code (nullable — само потвърдените)
  customsCode    String?  // митнически/CN код за CMR (напр. 25232900) — nullable
  unit           String   @default("t")
  packaging      String?  // напр. „25 kg bags"
  // Вид цимент (§5): "bulk" (Насипен) | "packaged" (Пакетиран). Nullable/additive —
  // старите записи остават без категория до sync-а. Управлява bulk/packaged cargo логиката.
  category       String?
  // Различава seeded canonical продукти от user-created (§16/§17). Canonical sync
  // архивира само стари system defaults, НИКОГА custom продукт на клиента.
  isSystemDefault Boolean @default(false)
  active         Boolean  @default(true)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  aliases   LogisticsProductAlias[]
  shipments Shipment[]

  @@unique([companyId, normalizedName])
  @@index([companyId, active])
}

// Историческ alias на продукт (формат разлики: 42,5 ↔ 42.5, с/без „/").
model LogisticsProductAlias {
  id             String @id @default(cuid())
  productId      String
  companyId      String
  alias          String
  normalizedAlias String
  createdAt      DateTime @default(now())

  product LogisticsProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([companyId, normalizedAlias])
  @@index([productId])
}

// Превозвачи (номенклатура).
model Carrier {
  id        String   @id @default(cuid())
  companyId String
  name      String
  eik       String?
  contact   String?
  phone     String?
  email     String?
  note      String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profiles VehicleLogisticsProfile[]
  configurations VehicleConfiguration[]

  @@index([companyId, active])
}

// Маршрути (номенклатура).
model LogisticsRoute {
  id          String   @id @default(cuid())
  companyId   String
  fromPlace   String
  toPlace     String
  distanceKm  Float?
  estTimeMin  Int?
  borderPoint String?
  note        String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, active])
}

// Настройки на модула по фирма (configurable defaults — snapshot към документа по-късно).
model LogisticsSettings {
  id          String   @id @default(cuid())
  companyId   String   @unique
  bgCurrency  String   @default("EUR")
  mkCurrency  String   @default("MKD")
  mkVatRate   Float    @default(18)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ─── Курс / Доставка (Shipment) — централен оперативен обект на логистиката ──
// Започва от Holcim експедиционна бележка. Получава concurrency-safe вътрешен номер
// (TR-YYYY-000001) чрез NumberSequence. Пази snapshots (продукт/автомобил/превозвач)
// за историческа коректност — бъдещи промени по master data не пренаписват курса.
model Shipment {
  id        String @id @default(cuid())
  companyId String
  code      String // TR-2026-000001
  seqYear   Int
  seqValue  Int

  // Holcim експедиционна бележка (начало на процеса)
  dispatchNoteNumber String?
  dispatchDate       DateTime?
  supplierId         String? // Holcim (Supplier record); nullable

  // Автомобил (reference + snapshot)
  vehicleId          String?
  vehicleRegSnapshot String?
  trailerReg         String?
  carrierId          String?
  carrierSnapshot    String?
  driver             String?

  // Продукт (reference + snapshot)
  productId            String?
  productNameSnapshot  String?
  materialCodeSnapshot String?
  unit                 String  @default("t")

  // Количества
  grossWeight Float?
  tara        Float?
  netQuantity Float?

  // Товарене / логистични метаданни (по образец на експедиционната бележка)
  contract     String?
  clientNumber String?
  factory      String?
  loadingPlace String?
  entryAt      DateTime?
  exitAt       DateTime?
  incoterm     String?
  destination  String?
  recipient    String?

  status      String    @default("loaded") // виж SHIPMENT_STATUSES (config)
  note        String?   @db.Text
  createdById String?
  deletedAt   DateTime? // soft delete / отмяна (не hard delete на записи във веригата)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company       Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle       Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  supplier      Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  product       LogisticsProduct?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  statusHistory ShipmentStatusHistory[]
  invoiceLinks  SupplierInvoiceShipmentLink[]
  proformaAllocation ProformaAllocation?
  documents     ShipmentDocument[]
  milestones    ShipmentMilestone[]
  importCosts   ImportCost[]
  bgMkLine      BgMkInvoiceLine?
  exportSets    ExportDocumentSet[]

  @@unique([companyId, code])
  // Една експедиционна бележка не може да бъде въведена два пъти в една фирма.
  @@unique([companyId, dispatchNoteNumber])
  @@index([companyId, status])
  @@index([vehicleId])
  @@index([productId])
}

// История на статусите (одит: кой, кога, от→към). Двама души работят паралелно.
model ShipmentStatusHistory {
  id          String   @id @default(cuid())
  shipmentId  String
  fromStatus  String?
  toStatus    String
  changedById String?
  note        String?
  createdAt   DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

// ─── Проформи / договорени количества (Holcim) ──────────────────────────────
// Клиентът следи количества по проформи от завода. „Изразходвано" НЕ се съхранява
// (изчислява се от алокациите → без drift). Остатък = initialQuantity − Σ алокации.
model LogisticsProforma {
  id              String   @id @default(cuid())
  companyId       String
  number          String?
  date            DateTime?
  supplierId      String?
  productId       String?
  productSnapshot String?  // snapshot на името за историческа коректност
  initialQuantity Float    // договорено количество
  unit            String   @default("t")
  currency        String   @default("EUR")
  unitPrice       Float?   // ако е приложимо
  status          String   @default("active") // active | closed | cancelled
  // Прикачен файл (по желание) — общ attachment механизъм (base64 dataUrl)
  fileName         String?
  originalFilename String?
  mimeType         String?
  dataUrl          String?  @db.Text
  note            String?  @db.Text
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  allocations ProformaAllocation[]

  @@index([companyId, status])
  @@index([supplierId])
}

// Приспадане на курс от проформа. Един курс се приспада от НАЙ-МНОГО една проформа.
model ProformaAllocation {
  id         String   @id @default(cuid())
  proformaId String
  shipmentId String   @unique
  quantity   Float    // приспаднато нето количество (snapshot)
  createdById String?
  createdAt  DateTime @default(now())

  proforma LogisticsProforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  shipment Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([proformaId])
}

// ─── Holcim фактура (входяща supplier invoice): 1 фактура → N курса ──────────
// Отделен модел (не Document engine): входящ документ с връзки към курсове и покупна
// цена/тон; не бива да ползва собствената номерация/DocumentType на фирмата.
model SupplierInvoice {
  id           String    @id @default(cuid())
  companyId    String
  supplierId   String?
  number       String
  date         DateTime?
  taxEventDate DateTime?
  currency     String    @default("EUR")
  vatRate      Float?    // ставка по подразбиране от фактурата — НЕ hardcode
  paymentMethod String?
  // Snapshot на страните (историческа коректност при бъдеща промяна на име/адрес)
  supplierSnapshot  String?
  recipientSnapshot String?
  // Header тотали, въведени от потребителя (от PDF) — за валидация срещу line totals.
  headerTaxBase    Float?
  headerVatTotal   Float?
  headerGrandTotal Float?
  // Прикачен оригинален PDF (по желание)
  fileName         String?
  originalFilename String?
  mimeType         String?
  dataUrl          String?  @db.Text
  note         String?   @db.Text
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  links   SupplierInvoiceShipmentLink[]

  // Един и същ номер фактура от същия доставчик не се въвежда два пъти.
  @@unique([companyId, supplierId, number])
  @@index([companyId])
}

// Ред от Holcim фактура ↔ курс. shipmentId е UNIQUE → една експедиционна бележка/курс
// НЕ може да бъде добавена към две фактури (Test 2). lineTotal = quantity × unitPrice.
// Ред от Holcim фактура ↔ курс (line-level). shipmentId е UNIQUE → 1 dispatch note →
// 1 supplier invoice line (Test 4). Immutable финансов snapshot: net/VAT/gross се пазят
// на реда (не се разчита само на текущата цена в Product).
model SupplierInvoiceShipmentLink {
  id         String @id @default(cuid())
  invoiceId  String
  // Свързаният курс. NULLABLE: фактурата е самостоятелен source документ — редът може
  // да бъде въведен ръчно и БЕЗ намерен Shipment (свързването става после). @unique
  // (nulls distinct) → един курс НЕ може да бъде фактуриран два пъти.
  shipmentId String? @unique
  lineNumber Int?   // № на реда във фактурата (напр. 10, 11, 21…)
  // Въведени от фактурата данни (immutable snapshot на реалния документ).
  // materialCode и materialName са ОТДЕЛНИ полета, макар Holcim да ги показва в 1 колона.
  dispatchNoteSnapshot String? // № експедиционна бележка (както е на фактурата)
  truckSnapshot        String? // автомобил (както е на фактурата)
  materialCodeSnapshot String? // шифър на материала
  materialName         String? // наименование на материала (снапшот от документа)
  productSnapshot      String? // име на разпознатия продукт (ако е mat-нат)
  unit                 String? // мерна единица (МЕ)
  // Финансови стойности (immutable snapshot; изчислени с decimal аритметика, с
  // възможност за ръчна корекция при rounding в оригинала).
  quantity  Float  // фактурирано количество (собствен snapshot; НЕ пренаписва курса)
  unitPrice Float  // единична цена
  vatRate   Float? // ставка на ДДС на реда (по подразбиране = header vatRate)
  lineTotal Float  // сума без ДДС = количество × единична цена
  vatAmount Float? // ДДС на реда
  grossAmount Float? // общо с ДДС = нето + ДДС
  currency  String @default("EUR")
  // Резултат от автоматичния matching към Shipment (не блокира записа):
  // matched | review | unmatched
  matchStatus String?
  createdAt DateTime @default(now())

  invoice  SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  shipment Shipment?       @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

// ─── Структурирани документи към курса (типизирани, не generic списък) ───────
// Видове: dispatch_note | holcim_invoice | proforma | cmr | waybill |
// customs_declaration | export_doc | import_doc | transport_invoice | border_doc |
// forwarder_doc | bg_mk_invoice | mk_invoice | payment_doc | other.
model ShipmentDocument {
  id               String    @id @default(cuid())
  shipmentId       String
  docType          String
  name             String?
  number           String?
  docDate          DateTime?
  note             String?   @db.Text
  filename         String?
  originalFilename String?
  mimeType         String?
  size             Int?
  dataUrl          String?   @db.Text
  uploadedById     String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

// ─── Транспортни етапи (очаквани времеви диапазони + реални часове) ──────────
// GPS НЕ се ползва (Phase 5): статуси + очаквани времена + ръчно потвърждение.
// milestone: loading | departure | border_arrival | border_crossing | arrival.
// Закъснението се ИЗЧИСЛЯВА (няма авто-промяна на реалния статус — раздел 22).
model ShipmentMilestone {
  id           String    @id @default(cuid())
  shipmentId   String
  milestone    String
  expectedFrom DateTime?
  expectedTo   DateTime?
  actualAt     DateTime?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, milestone])
  @@index([shipmentId])
}

// ─── Разходи при внос (Македония) ────────────────────────────────────────────
// Компоненти: transport | border_fee | customs_service | forwarding | tax |
// mk_vat | other. Всеки пази валута + курс snapshot към базовата валута.
// ДДВ обикновено НЕ влиза в икономическата себестойност (includeInCost=false) —
// раздел 49: данъците не се приемат автоматично за себестойност без настройка.
model ImportCost {
  id            String   @id @default(cuid())
  shipmentId    String
  costType      String
  amount        Float    // стойност във валутата на разхода
  currency      String   @default("EUR")
  fxRate        Float    @default(1) // множител към базовата валута (snapshot)
  baseAmount    Float    // amount × fxRate, в базовата валута (изчислено при запис)
  vatRate       Float?   // ставка (напр. 18 за mk_vat) — за информация
  includeInCost Boolean  @default(true) // дали влиза в себестойността
  auto          Boolean  @default(false) // автоматично изчислен или ръчен
  note          String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

// ─── Валутни курсове (EUR↔MKD и др.) ─────────────────────────────────────────
// Регистър за справка/предложение; конкретната операция пази собствен snapshot
// на използвания курс (ImportCost.fxRate). rate = единици quote за 1 base.
model LogisticsExchangeRate {
  id            String    @id @default(cuid())
  companyId     String
  baseCurrency  String    @default("EUR")
  quoteCurrency String    @default("MKD")
  rate          Float     // 1 base = rate quote (напр. 1 EUR = 61.5 MKD)
  date          DateTime?
  source        String?
  note          String?
  createdAt     DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, baseCurrency, quoteCurrency])
}

// ─── BG → MK intercompany фактура (един споделен документ) ───────────────────
// BG фирмата (companyId) продава на свързаната MK фирма (counterpartyCompanyId).
// ЕДИН запис, видим и от двете фирми: BG страна = издаден, MK страна = получен —
// без повторно въвеждане/качване. Позициите носят source shipment за traceability.
model BgMkInvoice {
  id                   String   @id @default(cuid())
  companyId            String   // издател (BG)
  counterpartyCompanyId String  // получател (MK) — член на същата CompanyGroup
  number               String
  date                 DateTime?
  currency             String   @default("EUR")
  vatRate              Float?
  note                 String?  @db.Text
  createdById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company      Company           @relation("BgMkIssuer", fields: [companyId], references: [id], onDelete: Cascade)
  counterparty Company           @relation("BgMkRecipient", fields: [counterpartyCompanyId], references: [id], onDelete: Cascade)
  lines        BgMkInvoiceLine[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([counterpartyCompanyId])
}

// Позиция от BG→MK фактура. shipmentId е UNIQUE → една стока не се продава на MK два
// пъти. Позициите после захранват MK продажбите (Phase 8) — enter once, use everywhere.
model BgMkInvoiceLine {
  id              String  @id @default(cuid())
  invoiceId       String
  shipmentId      String? @unique
  productId       String?
  productSnapshot String?
  unit            String  @default("t")
  quantity        Float
  unitPrice       Float
  lineTotal       Float   // нето
  vatAmount       Float?
  grossAmount     Float?
  currency        String  @default("EUR")
  createdAt       DateTime @default(now())

  invoice  BgMkInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  shipment Shipment?   @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  mkAllocations MkInvoiceLine[]

  @@index([invoiceId])
}

// ─── MK продажба към краен клиент (MK фактура) ───────────────────────────────
// MK фирмата (companyId) продава на MK клиент (Client). Позициите приспадат
// количество от полученото BG→MK inventory (BgMkInvoiceLine) — allocation ledger.
model MkInvoice {
  id          String   @id @default(cuid())
  companyId   String   // MK фирма (продавач)
  clientId    String?  // MK клиент
  // Директна връзка към получената BG→MK доставка (ExportDocumentSet), от която е
  // издадена тази MK фактура. Additive/nullable — allocation-based MK продажби
  // (mk-sales) остават с null. Статусът „Фактурирана" на получената доставка се
  // извежда от СЪЩЕСТВУВАНЕТО на MkInvoice с този sourceExportSetId (§18/§19).
  sourceExportSetId String?
  // Bridge към стандартната фактура (Document), ако легаси записът е консолидиран (§41/§43).
  // Additive/nullable + unique → 1:1. Новите MK продажби минават директно през Document.
  documentId  String?  @unique
  number      String
  date        DateTime?
  currency    String   @default("MKD")
  vatRate     Float?   // default 18 (конфигурируем)
  note        String?  @db.Text
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client          Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  sourceExportSet ExportDocumentSet? @relation(fields: [sourceExportSetId], references: [id], onDelete: SetNull)
  document        Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  lines           MkInvoiceLine[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@index([sourceExportSetId])
}

// Позиция от MK фактура = един ред от allocation ledger-а. Приспада quantity от
// конкретен източник (BgMkInvoiceLine). Остатък(източник) = получено − Σ приспаднати.
// Double-selling се пази чрез Serializable транзакция при създаване.
model MkInvoiceLine {
  id               String  @id @default(cuid())
  invoiceId        String
  sourceBgMkLineId String? // източник от полученото inventory (traceability + остатък)
  productSnapshot  String?
  unit             String  @default("t")
  quantity         Float
  unitPrice        Float
  lineTotal        Float   // нето
  vatAmount        Float?
  grossAmount      Float?
  currency         String  @default("MKD")
  createdAt        DateTime @default(now())

  invoice MkInvoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  source  BgMkInvoiceLine? @relation(fields: [sourceBgMkLineId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([sourceBgMkLineId])
}

// ─── Експортна доставка (еквивалент на Excel „ALL") — централен вход ─────────
// Едно въвеждане → генерира 6 документа (Invoice/Испратница/Празна/Декларация/
// CMR Epson/CMR HP) като snapshot-и. Всичко auto-fill + editable (AUTO-FILL, NOT LOCK).
model ExportDocumentSet {
  id                 String    @id @default(cuid())
  companyId          String    // продавач (BG, активната фирма)
  shipmentId         String?   // reuse на съществуващ курс (по желание)
  buyerCompanyId     String?   // свързаната MK фирма
  clientId           String?   // краен MK клиент (за Испратница)
  invoiceNumber      String
  invoiceDate        DateTime?   // дата на ИЗДАВАНЕ на фактурата (issue date)
  shipmentDate       DateTime?   // дата на ИЗПРАЩАНЕ (date of shipment) — отделна бизнес дата
  deliveryTerm       String?     // условия на доставка: FCA | CPT (Incoterm)
  placeOfShipment    String?     // място на натоварване (default „BELI IZVOR") — отделно от destination
  destination        String?
  routeId            String?
  truckVehicleId     String?
  truckRegSnapshot   String?
  trailerReg         String?
  logisticsProductId String?
  productSnapshot    String?
  quantity           Float?
  unit               String    @default("t")
  declarationCmrDate DateTime?
  dispatchNumber     String?
  status             String    @default("draft") // draft | ready | finalized | cancelled
  note               String?   @db.Text
  createdById        String?
  // Soft delete (Кошче). deletedAt != null → доставката е в Кошчето: скрита от
  // оперативните списъци, received-deliveries и MK invoicing, но пазена за
  // възстановяване/audit. Номерът НЕ се освобождава (§31). Same pattern като Document.
  deletedAt          DateTime?
  deletedById        String?
  deleteReason       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shipment    Shipment?         @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  documents   ExportDocument[]
  mkInvoices  MkInvoice[]       // легаси MK фактури (operational ledger) за тази доставка (§18)
  invoices    Document[]        @relation("ExportSetInvoices") // стандартни фактури (§17/§41)
  attachments ExportAttachment[] // допълнителни (качени) документи в досието (§7/§14)

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@index([companyId, deletedAt])
}

// Допълнителен (качен) документ в досието на експортна доставка (§7/§14). Съхранение по
// установения платформен механизъм — base64 dataUrl в БД (§12/§13, като DocumentAttachment/
// ClientFile). Metadata се зарежда в списъка; съдържанието (dataUrl) — само при сваляне (§50).
// Soft-delete на доставката НЕ трие attachment-ите (§40); hard delete cascade-ва (§41).
model ExportAttachment {
  id               String    @id @default(cuid())
  companyId        String
  exportSetId      String
  category         String    // enum-подобно: customs | dispatch_note | quality_spec | ... | other (§8)
  name             String    // име/описание (може да е custom label при „Друг документ")
  originalFilename String
  mimeType         String
  size             Int
  dataUrl          String    @db.Text
  documentNumber   String?
  documentDate     DateTime?
  notes            String?   @db.Text
  uploadedById     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  exportSet ExportDocumentSet @relation(fields: [exportSetId], references: [id], onDelete: Cascade)

  @@index([exportSetId])
  @@index([companyId, documentDate])
  @@index([companyId, category])
}

// Документ-snapshot от export set-а. `data` пази попълнените полета (auto-fill), после
// editable; `overridden` пази ръчните промени срещу тихо презаписване при regenerate.
model ExportDocument {
  id            String    @id @default(cuid())
  setId         String
  docType       String    // invoice | dispatch | blank | declaration | cmr_epson | cmr_hp
  data          Json
  overridden    Boolean   @default(false)
  status        String    @default("draft") // draft | ready | finalized | cancelled
  finalizedAt   DateTime?
  finalizedById String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  set ExportDocumentSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, docType])
  @@index([setId])
}

// Бонуси на служител — по месец, със сума, вид и бележка
model EmployeeBonus {
  id         String   @id @default(cuid())
  employeeId String
  year       Int
